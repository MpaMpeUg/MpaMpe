# Supabase/Postgres connection string. When omitted, the application runs
# against seeded read-only campaign content and safely accepts demo submissions.
DATABASE_URL=

# Supabase browser/auth configuration. These values are safe for browser use.
# Email confirmations and auth templates are configured in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Payment provider configuration. Keep all secrets server-side.
# Recommended first live candidates: flutterwave, pesapal, dpo, or yo_payments.
PAYMENT_PROVIDER=demo
PAYMENT_SECRET_KEY=
# For Flutterwave, this is the webhook secret hash checked against verif-hash.
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=

# MpaMpe-controlled settlement model. Provider payouts should settle here first.
MPAMPE_SETTLEMENT_ACCOUNT=mpampe_merchant

# Optional transactional email provider.
EMAIL_API_KEY=
EMAIL_FROM=info@mpampe.com

# Public site settings.
NEXT_PUBLIC_SITE_URL=https://mpampe.com
NEXT_PUBLIC_SUPPORT_PHONE=+256757163101
